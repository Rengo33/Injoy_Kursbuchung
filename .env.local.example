# === Basis ===
API_AUTH_TOKEN=your_api_auth_token_here
BOOKING_AUTH_TOKEN=your_booking_auth_token_here
CENTER_ID=27
DOMAIN=https://www.injoy-wolfsburg.de

# === Scheduler (Auto-Book via QStash) ===
APP_URL=https://your-vercel-app.vercel.app
QSTASH_TOKEN=your_qstash_token
SCHEDULER_SECRET=random_secret_string

# === Paid Tier (Phase 2) ===
# Solange FREE_MODE=true, sind alle Buchungen inkl. Auto-Book kostenlos.
# Auf false umstellen, sobald Stripe + Supabase konfiguriert sind.
FREE_MODE=true

# Stripe — nur aktiv wenn FREE_MODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase — nur aktiv wenn FREE_MODE=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
